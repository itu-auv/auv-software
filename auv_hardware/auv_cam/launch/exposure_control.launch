<?xml version="1.0"?>
<!-- RoI-metered exposure control for the front and bottom UVC cameras.
     Assumes cameras + cameras_<ns>.yaml are already up (start_cameras_*.launch):
     each node reads the 'device' param from its camera namespace and meters on
     that camera's image_raw. RoI is normalized [x, y, w, h]. -->
<launch>
  <arg name="namespace" default="taluy"/>
  <arg name="front" default="true"/>
  <arg name="bottom" default="true"/>
  <arg name="method" default="percentile"/> <!-- percentile | gradient -->
  <arg name="front_roi" default="[0.25, 0.25, 0.5, 0.5]"/>
  <arg name="bottom_roi" default="[0.25, 0.25, 0.5, 0.5]"/>
  <arg name="debug_image" default="true"/>

  <group ns="$(arg namespace)/cameras/cam_front" if="$(arg front)">
    <node name="exposure_control" pkg="auv_cam" type="exposure_control_node.py" output="screen">
      <param name="method" value="$(arg method)"/>
      <rosparam param="roi" subst_value="true">$(arg front_roi)</rosparam>
      <param name="debug_image" value="$(arg debug_image)"/>
    </node>
  </group>

  <group ns="$(arg namespace)/cameras/cam_bottom" if="$(arg bottom)">
    <node name="exposure_control" pkg="auv_cam" type="exposure_control_node.py" output="screen">
      <param name="method" value="$(arg method)"/>
      <rosparam param="roi" subst_value="true">$(arg bottom_roi)</rosparam>
      <param name="debug_image" value="$(arg debug_image)"/>
    </node>
  </group>
</launch>
