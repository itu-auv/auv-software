<launch>
  <arg name="namespace" default="taluy" />
  <arg name="name" default="cam_torpedo" />
  <arg name="compressed" default="true" />
  <arg name="verbose" default="true" />
  <arg name="pub_camera_info" default="true" />
  <!-- RTSP Parameters -->
  <arg name="rtsp_url" default="rtsp://192.168.1.65:554/" />
  <arg name="latency" default="0" />
  <arg name="buffer_mode" default="auto" />
  <arg name="drop_on_latency" default="true" />

  <!-- Reconnection Parameters -->
  <arg name="reconnect_interval_sec" default="5" />
  <arg name="max_consecutive_failures" default="100" />

  <!-- Video Parameters -->
  <arg name="width" default="640" />
  <arg name="height" default="480" />
  <arg name="fps" default="30" />

  <!-- Camera calibration parameters -->
  <arg name="camera_config" default="$(find-pkg-share auv_bringup)/config/cameras_$(var namespace).yaml"/>

  <group>
    <push_ros_namespace namespace="$(var namespace)/cameras" />
    <!-- Launch RTSP Camera -->
    <node name="$(var name)" exec="rtsp_cam_node" pkg="auv_cam" output="screen">
      <!-- camera settings and calibration: the section named after this node -->
      <param from="$(var camera_config)" />
      <!-- image_transport plugins to publish with -->
      <param if="$(var compressed)" name="image_raw.enable_pub_plugins" value="[image_transport/raw, image_transport/compressed]" />
      <param unless="$(var compressed)" name="image_raw.enable_pub_plugins" value="[image_transport/raw]" />
      <param name="verbose" type="bool" value="$(var verbose)" />
      <param name="pub_camera_info" value="$(var pub_camera_info)" />

      <!-- RTSP Parameters -->
      <param name="rtsp_url" value="$(var rtsp_url)" />
      <param name="latency" value="$(var latency)" />
      <param name="buffer_mode" value="$(var buffer_mode)" />
      <param name="drop_on_latency" value="$(var drop_on_latency)" />

      <!-- Reconnection Parameters -->
      <param name="reconnect_interval_sec" value="$(var reconnect_interval_sec)" />
      <param name="max_consecutive_failures" value="$(var max_consecutive_failures)" />

      <!-- Video Parameters -->
      <param name="width" value="$(var width)" />
      <param name="height" value="$(var height)" />
      <param name="fps" value="$(var fps)" />
    </node>
  </group>

  <include file="$(find-pkg-share auv_cam)/launch/inc/image_proc.launch.xml">
    <arg name="camera_namespace" value="$(var namespace)/cameras/$(var name)" />
  </include>
</launch>
