<launch>
  <arg name="namespace" default="taluy" />
  <arg name="name" default="auv_camera" />
  <arg name="compressed" default="true" />
  <arg name="verbose" default="true" />
  <arg name="pub_camera_info" default="false" />
  <arg name="camera_config" default="$(find-pkg-share auv_bringup)/config/cameras_$(var namespace).yaml"/>

  <group>
    <push_ros_namespace namespace="$(var namespace)/cameras" />
    <!-- Launch Camera -->
    <node name="$(var name)" exec="auv_gst_cam_node" pkg="auv_cam" output="screen">
      <!-- camera settings and calibration: the section named after this node -->
      <param from="$(var camera_config)" />
      <!-- image_transport plugins to publish with -->
      <param if="$(var compressed)" name="image_raw.enable_pub_plugins" value="[image_transport/raw, image_transport/compressed]" />
      <param unless="$(var compressed)" name="image_raw.enable_pub_plugins" value="[image_transport/raw]" />
      <param name="verbose" type="bool" value="$(var verbose)" />
      <param name="pub_camera_info" value="$(var pub_camera_info)" />
    </node>
  </group>

  <include file="$(find-pkg-share auv_cam)/launch/inc/image_proc.launch.xml">
    <arg name="camera_namespace" value="$(var namespace)/cameras/$(var name)" />
  </include>
</launch>
