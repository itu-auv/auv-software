<launch>
  <!-- ROS 2 realsense2_camera takes its settings as rs_launch.py arguments; only
       the ones this vehicle changes from the driver defaults are listed. -->
  <arg name="serial_no" default="''"/>
  <arg name="usb_port_id" default="''"/>
  <arg name="device_type" default="''"/>
  <arg name="json_file_path" default="''"/>
  <arg name="namespace" default="taluy"/>
  <arg name="camera" default="camera"/>
  <arg name="output" default="screen"/>
  <arg name="enable_depth" default="true"/>
  <arg name="enable_color" default="false"/>
  <arg name="enable_infra1" default="false"/>
  <arg name="enable_infra2" default="false"/>
  <arg name="enable_gyro" default="false"/>
  <arg name="enable_accel" default="false"/>
  <arg name="enable_pointcloud" default="true"/>
  <arg name="enable_sync" default="false"/>
  <arg name="align_depth" default="false"/>
  <arg name="publish_tf" default="false"/>
  <arg name="tf_publish_rate" default="0.0"/>
  <arg name="clip_distance" default="-2.0"/>
  <arg name="initial_reset" default="false"/>
  <arg name="reconnect_timeout" default="6.0"/>
  <arg name="wait_for_device_timeout" default="-1.0"/>

  <include file="$(find-pkg-share realsense2_camera)/launch/rs_launch.py">
    <arg name="camera_namespace" value="$(var namespace)"/>
    <arg name="camera_name" value="$(var camera)"/>
    <arg name="serial_no" value="$(var serial_no)"/>
    <arg name="usb_port_id" value="$(var usb_port_id)"/>
    <arg name="device_type" value="$(var device_type)"/>
    <arg name="json_file_path" value="$(var json_file_path)"/>
    <arg name="output" value="$(var output)"/>
    <arg name="enable_depth" value="$(var enable_depth)"/>
    <arg name="enable_color" value="$(var enable_color)"/>
    <arg name="enable_infra1" value="$(var enable_infra1)"/>
    <arg name="enable_infra2" value="$(var enable_infra2)"/>
    <arg name="enable_gyro" value="$(var enable_gyro)"/>
    <arg name="enable_accel" value="$(var enable_accel)"/>
    <arg name="pointcloud.enable" value="$(var enable_pointcloud)"/>
    <arg name="enable_sync" value="$(var enable_sync)"/>
    <arg name="align_depth.enable" value="$(var align_depth)"/>
    <arg name="publish_tf" value="$(var publish_tf)"/>
    <arg name="tf_publish_rate" value="$(var tf_publish_rate)"/>
    <arg name="clip_distance" value="$(var clip_distance)"/>
    <arg name="initial_reset" value="$(var initial_reset)"/>
    <arg name="reconnect_timeout" value="$(var reconnect_timeout)"/>
    <arg name="wait_for_device_timeout" value="$(var wait_for_device_timeout)"/>
  </include>
</launch>
