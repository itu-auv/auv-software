<?xml version="1.0"?>
<launch>
  <arg name="camera_namespace" default="image_raw"/>
  <arg name="respawn" default="false"/>
  <arg name="publish_monochrome" default="false"/>
  <arg name="debayer" default="false"/>
  <group>
    <push_ros_namespace namespace="$(var camera_namespace)"/>
    <let if="$(var debayer)" name="rectify_input" value="image_color"/>
    <let unless="$(var debayer)" name="rectify_input" value="image_raw"/>
    <!-- Debayered images -->
    <group if="$(var debayer)">
      <node pkg="image_proc" exec="debayer_node" name="debayer" respawn="$(var respawn)"/>
    </group>
    <!-- Monochrome rectified image -->
    <group if="$(var publish_monochrome)">
      <node pkg="image_proc" exec="rectify_node" name="rectify_mono" respawn="$(var respawn)">
        <remap from="image" to="image_mono"/>
      </node>
    </group>
    <node pkg="image_proc" exec="rectify_node" name="rectify_color" respawn="$(var respawn)">
      <remap from="image" to="$(var rectify_input)"/>
      <remap from="image_rect" to="image_rect_color"/>
    </node>
  </group>
</launch>
