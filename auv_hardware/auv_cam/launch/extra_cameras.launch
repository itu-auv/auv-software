<launch>
  <arg name="namespace" default="taluy"/>

  <include file="$(find-pkg-share auv_cam)/launch/realsense_camera.launch">
    <arg name="namespace" value="$(var namespace)"/>
  </include>
  <include file="$(find-pkg-share auv_cam)/launch/start_rtsp_camera.launch">
    <arg name="namespace" value="$(var namespace)"/>
    <arg name="name" value="cam_torpedo"/>
  </include>
</launch>
