<?xml version="1.0"?>
<model>
    <name>teknofest_tetra</name>
    <version>1.0</version>
    <sdf version='1.6'>model.sdf</sdf>

    <author>
        <name>ITU AUV Team</name>
    </author>

    <description>
        TEKNOFEST "yildizlar" 2nd-mission tetrahedron (60 cm, white base, RAL
        3020/6018/5000 side faces, letters A=red B=blue C=green in white).
        Meshes converted from valve-vision's assets/tetra/tetrahedron.gltf by
        scripts/tetra_gltf_to_collada.py.
    </description>
</model>
