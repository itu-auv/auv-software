<?xml version="1.0"?>
<!--
  TEKNOFEST "yildizlar" swim-through gate with the pinger socket on top.

  Geometry is NOT hand-modelled: the meshes are converted from valve-vision's
  assets/gate/gate.gltf (scripts/gate_gltf_to_collada.py), i.e. the exact asset
  the ViTPose gate checkpoint was trained on. Every number below is that
  asset's own declared part bbox, so this model and gate_tetra_overview.md §2
  cannot drift apart without the converter's verification failing.

  Model frame = valve-vision's object frame: origin at the footprint centre on
  the ground, Z up, +X = gate width, +Y = normal to the gate plane (along the
  feet). That is also the frame gate_pose publishes gate_link in, so a Gazebo
  ground-truth pose and our estimate are directly comparable — do not "fix" the
  orientation here; rotate the include in the .world instead.

  Two visuals because COLLADA carries one material per mesh: the SDF <material>
  blocks below are what actually colour it (RAL 9005 frame, RAL 1023 socket).
-->
<sdf version="1.6">
  <model name="teknofest_pinger">
    <static>true</static>
    <pose>0 0 0 0 0 0</pose>
    <link name="gate">
      <pose>0 0 0 0 0 0</pose>

      <!-- Collisions: primitive boxes over the mesh's 7 parts (a triangle
           soup collision for a static prop buys nothing but broadphase). -->
      <collision name="foot_left">
        <pose>-0.515 0 0.015 0 0 0</pose>
        <geometry><box><size>0.03 0.5 0.03</size></box></geometry>
      </collision>
      <collision name="foot_right">
        <pose>0.515 0 0.015 0 0 0</pose>
        <geometry><box><size>0.03 0.5 0.03</size></box></geometry>
      </collision>
      <collision name="post_left">
        <pose>-0.515 0 0.76 0 0 0</pose>
        <geometry><box><size>0.03 0.03 1.46</size></box></geometry>
      </collision>
      <collision name="post_right">
        <pose>0.515 0 0.76 0 0 0</pose>
        <geometry><box><size>0.03 0.03 1.46</size></box></geometry>
      </collision>
      <collision name="bottom_rail">
        <pose>0 0 0.045 0 0 0</pose>
        <geometry><box><size>1.0 0.03 0.03</size></box></geometry>
      </collision>
      <collision name="top_rail">
        <pose>0 0 1.475 0 0 0</pose>
        <geometry><box><size>1.0 0.03 0.03</size></box></geometry>
      </collision>
      <collision name="pinger_socket">
        <pose>0 0 1.54 0 0 0</pose>
        <geometry><cylinder><radius>0.0212</radius><length>0.10</length></cylinder></geometry>
      </collision>

      <visual name="frame">
        <geometry>
          <mesh><uri>model://teknofest_pinger/meshes/gate_frame.dae</uri></mesh>
        </geometry>
        <material>
          <ambient>0.02 0.02 0.021 1</ambient>
          <diffuse>0.055 0.055 0.06 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>
      <visual name="pinger_socket">
        <geometry>
          <mesh><uri>model://teknofest_pinger/meshes/gate_pinger.dae</uri></mesh>
        </geometry>
        <material>
          <ambient>0.34 0.26 0.0 1</ambient>
          <diffuse>0.98 0.73 0.0 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
