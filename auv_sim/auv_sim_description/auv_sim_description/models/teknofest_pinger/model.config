<?xml version="1.0"?>
<model>
    <name>teknofest_pinger</name>
    <version>1.0</version>
    <sdf version='1.6'>model.sdf</sdf>

    <author>
        <name>ITU AUV Team</name>
    </author>

    <description>
        TEKNOFEST "yildizlar" swim-through gate (RAL 9005 frame, RAL 1023
        pinger socket on the crossbar). Meshes converted from valve-vision's
        assets/gate/gate.gltf by scripts/gate_gltf_to_collada.py — the same
        asset the ViTPose gate model was trained on.
    </description>
</model>
