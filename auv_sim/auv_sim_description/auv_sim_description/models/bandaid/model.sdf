<?xml version="1.0"?>
<sdf version="1.6">
  <model name="bandaid">
    <pose>0 0 0 0 0 0</pose>
    <static>false</static>
    <allow_auto_disable>false</allow_auto_disable>
    <self_collide>false</self_collide>

  <link name="bandaid_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.01</ixx>
          <iyy>0.01</iyy>
          <izz>0.01</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <velocity_decay>
        <linear>0.05</linear>
        <angular>0.05</angular>
      </velocity_decay>
  <collision name="bandaid_col">
        <pose>0 0 0.014 0 0 0</pose>
        <geometry>
          <box>
            <size>0.0875 0.0875 0.032</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <kp>3000000</kp>
              <kd>300</kd>
              <max_vel>0.3</max_vel>
              <min_depth>0.03</min_depth>
            </ode>
          </contact>
          <friction>
            <ode>
              <mu>900.0</mu>
              <mu2>900.0</mu2>
              <slip1>0.0</slip1>
              <slip2>0.0</slip2>
            </ode>
          </friction>
          <bounce>
            <restitution_coefficient>0.2</restitution_coefficient>
          </bounce>
        </surface>
        <laser_retro>0.0</laser_retro>
        <max_contacts>5</max_contacts>
      </collision>

      <!-- Body. Without a material gz-sim uses a fully metallic default, which renders black -->
  <visual name="bandaid_vis_base">
        <pose>0 0 0.014 0 0 0</pose>
        <geometry>
          <box>
            <size>0.0875 0.0875 0.032</size>
          </box>
        </geometry>
        <material>
          <ambient>0.6 0.6 0.6 1</ambient>
          <diffuse>0.6 0.6 0.6 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>

      <!-- Decal visuals to display the texture on the caps -->
  <visual name="bandaid_vis_decal_top">
        <pose>0 0 0.031 0 0 0</pose>
        <geometry>
          <plane><normal>0 0 1</normal><size>0.087 0.087</size></plane>
        </geometry>
        <material>
          <ambient>0.8 0.8 0.8 1.0</ambient>
          <diffuse>0.8 0.8 0.8 1.0</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://bandaid/materials/textures/Task5_BandAid.png</albedo_map>
              <metalness>0</metalness>
              <roughness>0.8</roughness>
            </metal>
          </pbr>
        </material>
      </visual>

  <visual name="bandaid_vis_decal_bot">
        <pose>0 0 -0.003 0 3.14159 0</pose>
        <geometry>
          <plane><normal>0 0 1</normal><size>0.087 0.087</size></plane>
        </geometry>
        <material>
          <ambient>0.8 0.8 0.8 1.0</ambient>
          <diffuse>0.8 0.8 0.8 1.0</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://bandaid/materials/textures/Task5_BandAid.png</albedo_map>
              <metalness>0</metalness>
              <roughness>0.8</roughness>
            </metal>
          </pbr>
        </material>
      </visual>

    </link>
  </model>
</sdf>
