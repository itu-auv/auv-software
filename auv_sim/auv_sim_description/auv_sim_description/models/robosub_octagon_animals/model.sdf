<?xml version='1.0'?>
<sdf version="1.7">
  <model name="robosub_octagon_animals">
    <static>true</static>  <!-- Static for stability -->

    <!-- Repair hanging (facing +X) -->
    <link name="octagon_repair_link">
      <!-- Front face -->
      <visual name="visual1_front">
        <geometry>
          <plane>
            <normal>1 0 0</normal>
            <size>0.305 0.305</size>
          </plane>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://robosub_octagon_animals/materials/textures/Task5_Repair.png</albedo_map>
              <metalness>0</metalness>
              <roughness>0.8</roughness>
            </metal>
          </pbr>
        </material>
        <cast_shadows>false</cast_shadows>
        <pose>0 0 0.1525 1.5708 0 1.5708</pose>
      </visual>
      <!-- Back face -->
      <visual name="visual1_back">
        <geometry>
          <plane>
            <normal>-1 0 0</normal>
            <size>0.305 0.305</size>
          </plane>
        </geometry>
        <material>
          <ambient>0.5 0.5 0.5 1.0</ambient>
          <diffuse>0.5 0.5 0.5 1.0</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
        <cast_shadows>false</cast_shadows>
        <pose>0 0 0.1525 1.5708 0 1.5708</pose>
      </visual>
      <pose>0 0 0.4 0 0 0</pose>
    </link>

