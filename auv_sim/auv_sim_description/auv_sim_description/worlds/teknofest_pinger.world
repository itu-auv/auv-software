<?xml version="1.0"?>
<!-- Teknofest pinger gate world, based on tac_sea.world. -->
<sdf version="1.4">
  <world name="teknofest_pinger">
    <physics name="default_physics" default="true" type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>

    <spherical_coordinates>
      <latitude_deg>56.71897669633431</latitude_deg>
      <longitude_deg>3.515625</longitude_deg>
    </spherical_coordinates>

    <light type="directional" name="underwater_sun1">
      <pose>50 0 150 0 0 0</pose>
      <diffuse>0.05 0.1 0.2 0.1</diffuse>
      <specular>0.01 0.01 0.01 1</specular>
      <direction>0.1 0.1 -1</direction>
      <cast_shadows>false</cast_shadows>
    </light>
    <light type="directional" name="underwater_diffuse_1">
      <pose>-50 0 -150 0 0 0</pose>
      <diffuse>0.2 0.3 0.4 0.8</diffuse>
      <specular>0 0 0 1</specular>
      <direction>-0.1 -0.1 -0.9</direction>
      <cast_shadows>false</cast_shadows>
    </light>
    <light type="directional" name="underwater_diffuse_2">
      <pose>-100 500 -20 0 0 0</pose>
      <diffuse>0.3 0.4 0.5 0.6</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.2 -0.2 -0.7</direction>
      <cast_shadows>false</cast_shadows>
    </light>
    <light type="directional" name="underwater_diffuse_3">
      <pose>100 50 20 0 0 0</pose>
      <diffuse>0.15 0.2 0.25 0.6</diffuse>
      <specular>0 0 0 1</specular>
      <direction>-0.1 -0.1 -0.8</direction>
      <cast_shadows>false</cast_shadows>
    </light>
    <light type="directional" name="underwater_diffuse_4">
      <pose>-150 -130 50 0 0 0</pose>
      <diffuse>0.1 0.15 0.2 0.5</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <direction>0.2 0.2 -0.7</direction>
      <cast_shadows>false</cast_shadows>
    </light>

    <include>
      <uri>model://ned_frame</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>
    <!-- 8 m of water. The heightmap is flat for its own x >= 0 and climbs a
         9 m cliff below that, so its x offset is what sets how far ahead of
         the gate the wall stands: -10 puts it 15 m past the gate instead of
         the 5 m it started at. -->
    <include>
      <uri>model://sand_heightmap</uri>
      <pose>-10 0 -8 0 0 0</pose>
    </include>

    <!-- Feet on the sand: the model's origin is the footprint centre on the
         ground, so its z IS the seabed's.
         Yaw = pi/2 because the model keeps valve-vision's object frame
         (+X = gate width, +Y = plane normal), so the gate faces the robot,
         which spawns at x = 10 looking down -X. The model frame is
         deliberately not rotated at the source — gate_link comes out in it. -->
    <include>
      <uri>model://teknofest_pinger</uri>
      <name>teknofest_pinger_gate</name>
      <pose>5.062640 -0.076969 -8.000000 0 0 1.5707963267948966</pose>
    </include>

    <!-- Second mission target, 3 m past the gate on the approach line, resting
         on the sand (model origin is the base centroid, so z = seabed). Yaw is
         arbitrary: the bottom camera reads it from directly above. -->
    <include>
      <uri>model://teknofest_tetra</uri>
      <name>teknofest_tetra</name>
      <pose>2.062640 -0.076969 -8.000000 0 0 0</pose>
    </include>

    <plugin name="underwater_current_plugin" filename="libuuv_underwater_current_ros_plugin.so">
      <namespace>hydrodynamics</namespace>
      <constant_current>
        <topic>current_velocity</topic>
        <velocity>
          <mean>0</mean>
          <min>0</min>
          <max>5</max>
          <mu>0.0</mu>
          <noiseAmp>0.0</noiseAmp>
        </velocity>
        <horizontal_angle>
          <mean>0</mean>
          <min>-3.141592653589793238</min>
          <max>3.141592653589793238</max>
          <mu>0.0</mu>
          <noiseAmp>0.0</noiseAmp>
        </horizontal_angle>
        <vertical_angle>
          <mean>0</mean>
          <min>-3.141592653589793238</min>
          <max>3.141592653589793238</max>
          <mu>0.0</mu>
          <noiseAmp>0.0</noiseAmp>
        </vertical_angle>
      </constant_current>
    </plugin>

    <plugin name="sc_interface" filename="libuuv_sc_ros_interface_plugin.so" />

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>11 -10 2 0 0.35 2.35</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>
  </world>
</sdf>
