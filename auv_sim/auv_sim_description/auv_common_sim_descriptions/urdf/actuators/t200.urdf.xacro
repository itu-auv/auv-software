<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="t200_thruster">
  <xacro:macro name="t200_thruster_sim" params="name thruster_id">
    <gazebo>
      <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
        <joint_name>${name}_propeller_joint</joint_name>
        <velocity_control>true</velocity_control>
        <thrust_coefficient>0.004422</thrust_coefficient>
        <fluid_density>1028.0</fluid_density>
        <propeller_diameter>0.09</propeller_diameter>
      </plugin>
    </gazebo>
    <gazebo reference="${name}_propeller_link">
      <material>Gazebo/Orange</material>
      <selfCollide>false</selfCollide>
    </gazebo>
    <gazebo reference="${name}_link">
      <material>Gazebo/Orange</material>
    </gazebo>
  </xacro:macro>
</robot>
