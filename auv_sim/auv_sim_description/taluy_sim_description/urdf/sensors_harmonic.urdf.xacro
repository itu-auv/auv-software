<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:gz="http://gazebosim.org/schemas">
  <xacro:macro name="taluy_harmonic_sensors" params="namespace camera_update_rate:=10.0">
    <gazebo reference="${namespace}/base_link">
      <sensor name="front_camera" type="camera">
        <pose>0.41125 0 0 0 0 0</pose>
        <gz_frame_id>${namespace}/base_link/front_camera_optical_link</gz_frame_id>
        <always_on>true</always_on>
        <update_rate>${camera_update_rate}</update_rate>
        <topic>/model/${namespace}/front_camera/image</topic>
        <camera>
          <horizontal_fov>1.3962634</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.1</near><far>20</far></clip>
        </camera>
      </sensor>
      <sensor name="bottom_camera" type="camera">
        <pose>0 0 -0.08 0 1.57079632679 1.57079632679</pose>
        <gz_frame_id>${namespace}/base_link/bottom_camera_optical_link</gz_frame_id>
        <always_on>true</always_on>
        <update_rate>${camera_update_rate}</update_rate>
        <topic>/model/${namespace}/bottom_camera/image</topic>
        <camera>
          <horizontal_fov>1.3962634</horizontal_fov>
          <image><width>1920</width><height>1080</height><format>R8G8B8</format></image>
          <clip><near>0.1</near><far>20</far></clip>
        </camera>
      </sensor>
      <sensor name="torpedo_camera" type="camera">
        <pose>-0.4179613058 0.1 -0.1481211354 0 -0.088 3.14159265359</pose>
        <gz_frame_id>${namespace}/base_link/torpedo_camera_optical_link</gz_frame_id>
        <always_on>true</always_on>
        <update_rate>${camera_update_rate}</update_rate>
        <topic>/model/${namespace}/torpedo_camera/image</topic>
        <camera>
          <horizontal_fov>1.3962634</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.1</near><far>20</far></clip>
        </camera>
      </sensor>
      <sensor name="imu" type="imu">
        <pose>-0.162 0 -0.0108 3.141592653589793 0 0</pose>
        <always_on>true</always_on>
        <update_rate>20</update_rate>
        <topic>/model/${namespace}/imu</topic>
        <gz_frame_id>${namespace}/base_link/imu_link</gz_frame_id>
        <imu>
          <orientation_reference_frame><localization>ENU</localization></orientation_reference_frame>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.0002514074</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.0002514074</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.0002514074</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.00104347826</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.00104347826</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.00104347826</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>

      <sensor name="dvl" type="custom" gz:type="dvl">
        <pose>0.2 0 -0.18 0 0 -0.7853981633974483</pose>
        <always_on>true</always_on>
        <update_rate>20</update_rate>
        <topic>/model/${namespace}/dvl/velocity</topic>
        <gz_frame_id>${namespace}/base_link/dvl_link</gz_frame_id>
        <gz:dvl>
          <type>phased_array</type>
          <arrangement degrees="true">
            <beam id="1"><aperture>2</aperture><rotation>45</rotation><tilt>30</tilt></beam>
            <beam><aperture>2</aperture><rotation>135</rotation><tilt>30</tilt></beam>
            <beam><aperture>2</aperture><rotation>-45</rotation><tilt>30</tilt></beam>
            <beam><aperture>2</aperture><rotation>-135</rotation><tilt>30</tilt></beam>
          </arrangement>
          <tracking>
            <bottom_mode><when>best</when><visualize>false</visualize></bottom_mode>
          </tracking>
          <resolution>0.01</resolution>
          <maximum_range>100</maximum_range>
          <minimum_range>0.1</minimum_range>
          <reference_frame>0 0 0 0 0 0</reference_frame>
        </gz:dvl>
      </sensor>
    </gazebo>
    <gazebo>
      <plugin filename="auv-subsea-pressure-system" name="auv_sim_bridge::SubseaPressureSystem">
        <link_name>${namespace}/base_link</link_name>
        <frame_id>${namespace}/base_link/external_pressure_sensor_chasis_link</frame_id>
        <sensor_pose>0 0 0.079 0 0 0</sensor_pose>
        <topic>/model/${namespace}/pressure</topic>
        <update_rate>20</update_rate>
        <standard_pressure>101.325</standard_pressure>
        <kPa_per_meter>9.80638</kPa_per_meter>
        <noise_sigma>0.4</noise_sigma>
        <noise_amplitude>0.13</noise_amplitude>
      </plugin>
    </gazebo>
  </xacro:macro>
</robot>
