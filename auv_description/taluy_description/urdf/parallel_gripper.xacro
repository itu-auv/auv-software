<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Load inertial macros -->
  <xacro:macro name="cylinder_inertia" params="mass r h">
    <inertia ixx="${mass*(3*r*r+h*h)/12}" ixy="0.0" ixz="0.0" iyy="${mass*(3*r*r+h*h)/12}" iyz="0.0" izz="${mass*r*r/2}"/>
  </xacro:macro>

  <xacro:macro name="box_inertia" params="mass x y z">
    <inertia ixx="${mass*(y*y+z*z)/12}" ixy="0.0" ixz="0.0" iyy="${mass*(x*x+z*z)/12}" iyz="0.0" izz="${mass*(x*x+y*y)/12}"/>
  </xacro:macro>

  <!-- Parallel Gripper Macro -->
  <xacro:macro name="parallel_gripper" params="namespace parent_link mass_scale:=0.001 mount_xyz:='0 0 0' mount_rpy:='0 0 0'">
    <!-- Custom connection mapping to attach from base to the tip backward to gripper base -->

    <!-- Virtual link representing the tip (where the gripper actually touches what it holds) -->
    <link name="${namespace}/gripper_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.001"/>
        <inertia ixx="0.000001" ixy="0.0" ixz="0.0" iyy="0.000001" iyz="0.0" izz="0.000001"/>
      </inertial>
    </link>

    <!-- Joint connecting parent (e.g. base_link) to gripper_link -->
    <joint name="${namespace}/gripper_link_joint" type="fixed">
      <origin xyz="${mount_xyz}" rpy="${mount_rpy}"/>
      <parent link="${parent_link}"/>
      <child link="${namespace}/gripper_link"/>
    </joint>

    <link name="${namespace}/gripper_link_p2"/>
    <link name="${namespace}/gripper_link_p4"/>
    <link name="${namespace}/gripper_link_n2"/>
    <link name="${namespace}/gripper_link_n4"/>

    <joint name="${namespace}/gripper_front_joint" type="fixed">
      <origin xyz="0.02 0 0" rpy="0 0 0"/>
      <parent link="${namespace}/gripper_link"/>
      <child link="${namespace}/gripper_link_p2"/>
    </joint>

    <joint name="${namespace}/gripper_rear_joint" type="fixed">
      <origin xyz="0.04 0 0" rpy="0 0 0"/>
      <parent link="${namespace}/gripper_link"/>
      <child link="${namespace}/gripper_link_p4"/>
    </joint>

    <joint name="${namespace}/gripper_front_joint_2" type="fixed">
      <origin xyz="-0.02 0 0" rpy="0 0 0"/>
      <parent link="${namespace}/gripper_link"/>
      <child link="${namespace}/gripper_link_n2"/>
    </joint>

    <joint name="${namespace}/gripper_rear_joint_2" type="fixed">
      <origin xyz="-0.04 0 0" rpy="0 0 0"/>
      <parent link="${namespace}/gripper_link"/>
      <child link="${namespace}/gripper_link_n4"/>
    </joint>

    <!-- Gripper Mount Link (offset from tip up to the base of the gripper) -->
    <link name="${namespace}/gripper_mount_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.001"/>
        <inertia ixx="0.000001" ixy="0.0" ixz="0.0" iyy="0.000001" iyz="0.0" izz="0.000001"/>
      </inertial>
    </link>

    <!-- The offset from tip backwards to the base -->
    <joint name="${namespace}/gripper_mount_joint" type="fixed">
      <origin xyz="0 0 0.193" rpy="0 0 0"/>
      <parent link="${namespace}/gripper_link"/>
      <child link="${namespace}/gripper_mount_link"/>
    </joint>

    <!-- Gripper Base Link -->
    <link name="${namespace}/gripper_base">
      <inertial>
        <origin rpy="0 0 0" xyz="0.024426 0.0 0.0"/>
        <mass value="${3.5*mass_scale}"/>
        <xacro:box_inertia mass="${3.5*mass_scale}" x="0.074326" y="0.117427" z="0.114298"/>
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://taluy_description/meshes/parallel_gripper/visual/BaseGripper.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0.024426 0.0 0.0"/>
        <geometry>
          <box size="0.074326 0.117427 0.114298"/>
        </geometry>
      </collision>
    </link>

    <!-- Joint connecting the virtual mount link to gripper base -->
    <joint name="${namespace}/gripper_base_joint" type="fixed">
      <parent link="${namespace}/gripper_mount_link"/>
      <child link="${namespace}/gripper_base"/>
      <origin xyz="0 0 0" rpy="0 ${math.pi/2} 0"/>
    </joint>

    <!-- Left Finger -->
    <link name="${namespace}/finger_left">
      <inertial>
        <origin rpy="0 0 0" xyz="0.032 0 0"/>
        <mass value="${0.88*mass_scale}"/>
        <!-- Clamp inertia to avoid solver instability with very small masses -->
        <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://taluy_description/meshes/parallel_gripper/visual/Finger.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0.032 0 0"/>
        <geometry>
          <box size="0.064 0.078 0.025"/>
        </geometry>
      </collision>
    </link>

    <!-- Left Finger Joint -->
    <joint name="${namespace}/finger_left_joint" type="revolute">
      <parent link="${namespace}/gripper_base"/>
      <child link="${namespace}/finger_left"/>
      <!-- Y mesafesi artırıldı: 0.055 -> 0.065 (parmaklar arası mesafe daha da arttı) -->
      <origin rpy="0 0 0" xyz="0.0444267 0.065 0"/>
      <axis xyz="0 0 1"/>
      <!-- Dengeli ayar: Güçlü ama yumuşak (titreşim önleme) -->
      <dynamics damping="30" friction="8"/>
      <!-- Effort optimal: 100 -> 80 Nm (hala çok güçlü), velocity biraz daha yavaş -->
      <limit effort="80" lower="-0.15" upper="0.25" velocity="0.02"/>
    </joint>

    <!-- Left Finger Tip -->
    <link name="${namespace}/finger_tip_left">
      <inertial>
        <origin rpy="0 0 0" xyz="0.042 0 0"/>
        <mass value="${1.13*mass_scale}"/>
        <!-- Clamp inertia to avoid solver instability with very small masses -->
        <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://taluy_description/meshes/parallel_gripper/visual/FingerTip.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0.042 0 0"/>
        <geometry>
          <box size="0.084 0.048 0.024"/>
        </geometry>
      </collision>
    </link>

    <!-- Left Finger Tip Joint (fixed for stability) -->
    <joint name="${namespace}/finger_tip_left_joint" type="fixed">
      <parent link="${namespace}/finger_left"/>
      <child link="${namespace}/finger_tip_left"/>
      <!-- Ucu daha fazla içe doğru: Z ekseninde -0.15 rad (~-8.6°) rotasyon ekleyerek uç içe bakar -->
      <origin rpy="3.14159265359 0 -0.15" xyz="0.06431 0 0"/>
    </joint>

    <!-- Right Finger -->
    <link name="${namespace}/finger_right">
      <inertial>
        <origin rpy="0 0 0" xyz="0.032 0 0"/>
        <mass value="${0.88*mass_scale}"/>
        <!-- Clamp inertia to avoid solver instability with very small masses -->
        <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
      </inertial>
      <visual>
        <origin rpy="3.14159265359 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://taluy_description/meshes/parallel_gripper/visual/Finger.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="3.14159265359 0 0" xyz="0.032 0 0"/>
        <geometry>
          <box size="0.064 0.078 0.025"/>
        </geometry>
      </collision>
    </link>

    <!-- Right Finger Joint -->
    <joint name="${namespace}/finger_right_joint" type="revolute">
      <parent link="${namespace}/gripper_base"/>
      <child link="${namespace}/finger_right"/>
      <!-- Y mesafesi artırıldı: -0.055 -> -0.065 (parmaklar arası mesafe daha da arttı) -->
      <origin rpy="3.14159265359 3.14159265359 3.14159265359" xyz="0.0444267 -0.065 0"/>
      <axis xyz="0 0 -1"/>
      <!-- Dengeli ayar: Güçlü ama yumuşak (titreşim önleme) -->
      <dynamics damping="30" friction="8"/>
      <!-- Effort optimal: 100 -> 80 Nm (hala çok güçlü), velocity biraz daha yavaş -->
      <limit effort="80" lower="-0.15" upper="0.25" velocity="0.02"/>
    </joint>

    <!-- Right Finger Tip -->
    <link name="${namespace}/finger_tip_right">
      <inertial>
        <origin rpy="0 0 0" xyz="0.042 0 0"/>
        <mass value="${1.13*mass_scale}"/>
        <!-- Clamp inertia to avoid solver instability with very small masses -->
        <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://taluy_description/meshes/parallel_gripper/visual/FingerTip.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0.042 0 0"/>
        <geometry>
          <box size="0.084 0.048 0.024"/>
        </geometry>
      </collision>
    </link>

    <!-- Right Finger Tip Joint (fixed for stability) -->
    <joint name="${namespace}/finger_tip_right_joint" type="fixed">
      <parent link="${namespace}/finger_right"/>
      <child link="${namespace}/finger_tip_right"/>
      <!-- Ucu daha fazla içe doğru: Z ekseninde +0.15 rad (~+8.6°) rotasyon ekleyerek uç içe bakar -->
      <origin rpy="0 0 0.15" xyz="0.06431 0 0"/>
    </joint>

  </xacro:macro>
</robot>
