<?xml version="1.0"?>
<launch>
    <arg name="namespace" default="taluy" />
    <arg name="waypoint_prefix" default="path" />
    <arg name="default_waypoint_z" default="-1.0" />
    <arg name="set_waypoint_service" default="map/set_waypoint" />
    <arg name="get_waypoint_service" default="map/get_waypoint" />

    <!--
      Canvas bounds in the per-path local frame (A = 0,0; +x forward in ref coords).
      Canvas horizontal = -y_ref, canvas vertical = +x_ref, so these bounds read as:
        x_min/x_max -> horizontal span of the canvas in metres (left/right of A)
        y_min/y_max -> vertical span of the canvas in metres (behind/ahead of A)
    -->
    <arg name="canvas_x_min" default="-8.0" />
    <arg name="canvas_x_max" default="8.0" />
    <arg name="canvas_y_min" default="-2.0" />
    <arg name="canvas_y_max" default="18.0" />
    <arg name="b_arrow_length" default="12.0" />

    <group>
      <push_ros_namespace namespace="$(var namespace)" />
        <node name="waypoint_gui" pkg="auv_mapping" exec="waypoint_gui.py" output="screen">
            <param name="set_waypoint_service" value="$(var set_waypoint_service)" />
            <param name="get_waypoint_service" value="$(var get_waypoint_service)" />
            <param name="waypoint_prefix" value="$(var waypoint_prefix)" />
            <param name="default_waypoint_z" value="$(var default_waypoint_z)" />

            <param name="canvas_x_min" value="$(var canvas_x_min)" />
            <param name="canvas_x_max" value="$(var canvas_x_max)" />
            <param name="canvas_y_min" value="$(var canvas_y_min)" />
            <param name="canvas_y_max" value="$(var canvas_y_max)" />
            <param name="b_arrow_length" value="$(var b_arrow_length)" />

            <param name="reference_frame_options" value="[odom, coin_flip, gate_exit, torpedo_map_link_kde, octagon_link_kde, bin_basket_front_link_kde]" />
        </node>
    </group>
</launch>
