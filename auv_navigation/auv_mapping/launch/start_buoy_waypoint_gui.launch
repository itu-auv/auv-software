<?xml version="1.0"?>
<launch>
  <arg name="namespace" default="taluy" />

  <group ns="$(arg namespace)">
    <node
      name="buoy_waypoint_gui"
      pkg="auv_mapping"
      type="buoy_waypoint_gui.py"
      output="screen">
      <remap from="map/set_buoy_waypoints" to="map/set_buoy_waypoints" />
    </node>
  </group>
</launch>
