<!-- Object Plane Fitter Launch File -->
<launch>
    <arg name="namespace" default="taluy" />

    <arg name="depth_topic" default="depth_anything/raw_depth"/>
    <arg name="scaled_camera_info_topic" default="depth_anything/scaled_camera_info"/>
    <arg name="original_camera_info_topic" default="cameras/cam_torpedo/camera_info"/>
    <arg name="detections_topic" default="/yolo_detections_torpedo"/>

    <!-- Use -1 to accept all classes, or specify class ID (e.g., 0, 1, 2...) -->
    <arg name="target_class_id" default="4"/>
    <arg name="ransac_distance_threshold" default="0.05"/>
    <arg name="ransac_max_iterations" default="1000"/>
    <arg name="depth_scale_factor" default="1.0"/>
    <arg name="min_inlier_ratio" default="0.5"/>
    <arg name="publish_debug" default="true"/>
    <arg name="output_frame_id" default=""/>
    <arg name="sync_queue_size" default="30"/>

    <group>
      <push_ros_namespace namespace="$(var namespace)" />
        <node name="object_plane_fitter" pkg="auv_mapping" exec="object_plane_fitter_node" output="screen">
          <param name="target_class_id" value="$(var target_class_id)"/>
          <param name="ransac_distance_threshold" value="$(var ransac_distance_threshold)"/>
          <param name="ransac_max_iterations" value="$(var ransac_max_iterations)"/>
          <param name="depth_scale_factor" value="$(var depth_scale_factor)"/>
          <param name="min_inlier_ratio" value="$(var min_inlier_ratio)"/>
          <param name="publish_debug" value="$(var publish_debug)"/>
          <param name="output_frame_id" value="$(var output_frame_id)"/>
          <param name="sync_queue_size" value="$(var sync_queue_size)" type="int"/>

          <remap from="depth" to="$(var depth_topic)"/>
          <remap from="camera_info" to="$(var scaled_camera_info_topic)"/>
          <remap from="original_camera_info" to="$(var original_camera_info_topic)"/>
          <remap from="detections" to="$(var detections_topic)"/>
          <remap from="object_transform_updates" to="map/object_transform_updates"/>
          <remap from="depth_enable" to="depth_anything_trt_node/enable"/>
          <remap from="tracker_enable" to="/tracker_node_torpedo_front/enable"/>
      </node>
    </group>
</launch>
