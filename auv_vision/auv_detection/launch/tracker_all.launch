<?xml version="1.0"?>
<launch>
    <!-- Camera selection flags -->
    <arg name="front" default="true"/>
    <arg name="bottom" default="true"/>
    <arg name="realsense" default="true"/>
    <arg name="segment" default="false"/>
    <arg name="detection" default="false"/>

    <!-- Common settings -->
    <arg name="use_gui" default="false"/>

    <!-- Front camera tracker -->
    <group if="$(var front)">
      <push_ros_namespace namespace="tracker_front" />
        <include file="$(find-pkg-share auv_detection)/launch/inc/tracker_front.launch">
            <arg name="use_gui" value="$(var use_gui)"/>
        </include>
    </group>

    <!-- Bottom camera tracker -->
    <group if="$(var bottom)">
      <push_ros_namespace namespace="tracker_bottom" />
        <include file="$(find-pkg-share auv_detection)/launch/inc/tracker_bottom.launch">
            <arg name="use_gui" value="$(var use_gui)"/>
        </include>
    </group>

    <!-- RealSense camera tracker -->
    <group if="$(var realsense)">
      <push_ros_namespace namespace="tracker_realsense" />
        <include file="$(find-pkg-share auv_detection)/launch/inc/tracker_realsense.launch">
            <arg name="use_gui" value="$(var use_gui)"/>
        </include>
    </group>

    <!-- Segmentation tracker -->
    <group if="$(var segment)">
      <push_ros_namespace namespace="tracker_segment" />
        <include file="$(find-pkg-share auv_detection)/launch/inc/tracker_segment.launch">
            <arg name="use_gui" value="$(var use_gui)"/>
        </include>
    </group>

    <!-- Shape detection tracker -->
    <group if="$(var detection)">
      <push_ros_namespace namespace="tracker_detection" />
        <include file="$(find-pkg-share auv_detection)/launch/inc/tracker_detection.launch">
            <arg name="use_gui" value="$(var use_gui)"/>
        </include>
    </group>
</launch>
