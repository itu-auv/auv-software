<launch>
  <!-- Arguments -->
  <arg name="namespace" default="taluy" />
  <!-- camera options: front | bottom | torpedo | realsense -->
  <arg name="camera" default="front" />
  <arg name="base_dir" default="$(env HOME)/Desktop" />
  <arg name="folder_name" default="yolo_bag" />
  <arg name="interval_seconds" default="1.0" />
  <arg name="images_per_folder" default="150" />

  <!-- Image saver node -->
  <node pkg="auv_bringup" exec="image_saver.py" name="image_saver" output="screen">
    <param name="namespace" value="$(var namespace)" />
    <param name="camera" value="$(var camera)" />
    <param name="base_dir" value="$(var base_dir)" />
    <param name="folder_name" value="$(var folder_name)" />
    <param name="interval_seconds" value="$(var interval_seconds)" />
    <param name="images_per_folder" value="$(var images_per_folder)" />
  </node>
</launch>
