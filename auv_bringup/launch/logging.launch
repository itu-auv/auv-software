<?xml version="1.0"?>
<launch>
  <arg name="namespace" default="taluy"/>
  <arg name="prefix" default="log"/>
  <arg name="logging_directory" default="$(env HOME)/bags"/>
  <arg name="include_pattern" default=".*"/>
  <arg name="exclude_pattern" default="^/(?!.*(?:image_rect_color/compressed|yolo_image_[^/]+/compressed|segment_pose_debug/compressed|kde_map/visualization/compressed|camera/color/image_raw/compressed|camera/depth/image_rect_raw/compressed)$).*(?:image|compressed).*$|^/.*(?:points_filtered|points|cloud|mask)$|^/(?:.*/)?depth_anything/(?:raw_depth|rgb_point_cloud)$|^/yolo_result_seg$"/>
  <arg name="topics" default=""/>
  <arg name="log_filename" default=""/>
  <group>
    <push_ros_namespace namespace="$(var namespace)" />
    <!-- rosbag2 has no output prefix option; the start time is appended here -->
    <executable
      name="auv_logger"
      output="screen"
      cmd="ros2 bag record -o $(var logging_directory)/$(var prefix)$(var log_filename)_$(eval &quot;__import__('datetime').datetime.now().strftime('%Y-%m-%d-%H-%M-%S')&quot;) --regex '$(var include_pattern)' --exclude-regex '$(var exclude_pattern)' $(var topics)"
    />
  </group>
</launch>
