<?xml version="1.0"?>
<launch>
  <arg name="namespace" default="taluy_mini"/>
  <arg name="compressed" default="true"/>
  <arg name="verbose" default="false"/>
  <arg name="pub_camera_info" default="true"/>


  <group>
    <push_ros_namespace namespace="$(var namespace)/cameras/cam_front" />
    <!-- named after its section in the cameras file -->
    <node name="cam_front" pkg="auv_cam" exec="oak_cam.py" output="screen">
      <param from="$(find-pkg-share auv_bringup)/config/cameras_$(var namespace).yaml" />
    </node>
    <!-- image_transport publishes image_raw/compressed automatically in c++ -->
    <node if="$(var compressed)" name="republish_raw" pkg="image_transport" exec="republish">
      <param name="in_transport" value="raw" />
      <param name="out_transport" value="compressed" />
      <remap from="in" to="image_raw" />
      <remap from="out/compressed" to="image_raw/compressed" />
    </node>
  </group>
  <include file="$(find-pkg-share auv_cam)/launch/inc/image_proc.launch.xml">
    <arg name="camera_namespace" value="$(var namespace)/cameras/cam_front" />
  </include>

  <!-- <include file="$(find-pkg-share auv_cam)/launch/start_gst_camera.launch">
    <arg name="namespace" value="$(var namespace)"/>
    <arg name="compressed" value="$(var compressed)"/>
    <arg name="verbose" value="$(var verbose)"/>
    <arg name="name" value="cam_bottom"/>
    <arg name="pub_camera_info" value="$(var pub_camera_info)"/>
  </include> -->

</launch>
