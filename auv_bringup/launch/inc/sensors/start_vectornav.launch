<?xml version="1.0"?>
<launch>
  <arg name="namespace" default="taluy_mini" />

  <group>
    <push_ros_namespace namespace="$(var namespace)" />
    <!-- ROS 2 driver (dawonn/vectornav, ros2 branch): one node talks to the sensor,
         a second one turns its output into sensor_msgs. Not yet run on the VN100. -->
    <node pkg="vectornav" exec="vectornav" name="auv_vectornav_node" output="screen">
      <param from="$(find-pkg-share auv_bringup)/config/vn100.yaml" />
    </node>
    <node pkg="vectornav" exec="vn_sensor_msgs" name="auv_vectornav_sensor_msgs" output="screen">
      <param from="$(find-pkg-share auv_bringup)/config/vn100.yaml" />
      <remap from="vectornav/imu" to="sensors/imu/data"/>
    </node>
  </group>
</launch>
