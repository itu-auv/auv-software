<?xml version="1.0"?>
<launch>
  <arg name="namespace" default="taluy"/>
  <arg name="compressed" default="true"/>
  <arg name="verbose" default="false"/>
  <arg name="pub_camera_info" default="true"/>
  <!-- launch front camera -->
  <include file="$(find-pkg-share auv_cam)/launch/start_gst_camera.launch">
    <arg name="namespace" value="$(var namespace)"/>
    <arg name="compressed" value="$(var compressed)"/>
    <arg name="verbose" value="$(var verbose)"/>
    <arg name="name" value="cam_front"/>
    <arg name="pub_camera_info" value="$(var pub_camera_info)"/>
  </include>
  <!-- launch bottom camera -->
  <include file="$(find-pkg-share auv_cam)/launch/start_gst_camera.launch">
    <arg name="namespace" value="$(var namespace)"/>
    <arg name="compressed" value="$(var compressed)"/>
    <arg name="verbose" value="$(var verbose)"/>
    <arg name="name" value="cam_bottom"/>
    <arg name="pub_camera_info" value="$(var pub_camera_info)"/>
  </include>
  <include file="$(find-pkg-share auv_cam)/launch/extra_cameras.launch">
  </include>


  <!-- launch ov2710 camera -->
  <!-- <include file="$(find-pkg-share auv_cam)/launch/start_gst_camera.launch">
    <arg name="namespace" value="$(var namespace)"/>
    <arg name="compressed" value="$(var compressed)"/>
    <arg name="verbose" value="$(var verbose)"/>
    <arg name="name" value="cam_ov2710"/>
    <arg name="pub_camera_info" value="$(var pub_camera_info)"/>
  </include> -->
  <!-- launch realsense camera -->
  <!-- <node name="usb_cam" pkg="usb_cam" exec="usb_cam_node" respawn="true">
      <param name="video_device" value="/dev/video0" />
      <param name="image_width" value="1280" />
      <param name="image_height" value="720" />
      <param name="pixel_format" value="mjpeg" />
      <param name="camera_frame_id" value="usb_cam" />
      <param name="io_method" value="mmap" />
    </node> -->
</launch>
