<?xml version="1.0"?>
<launch>
  <arg name="namespace" default="taluy" />
  <arg name="control_rate" default="20.0" />
  <arg name="localization_disabled_at_startup" default="true" />
  <arg name="plane_fitter_sync_queue_size" default="30" />
  <arg name="model" default="$(find-pkg-share $(var namespace)_description)/urdf/auv.urdf.xacro" />
  <arg name="rviz_config" default="$(find-pkg-share $(var namespace)_description)/rviz/araba.rviz" />
  <arg name="dvl_virtual_port" default="/dev/auv_wayfinder_dvl" />
  <arg name="use_gui" default="false" />
  <arg name="enable_logging" default="false" />
  <arg name="logging_directory" default="$(env HOME)/bags" />
  <arg name="log_filename" default="" />

  <!-- these two reach every node started below, like ROS 1 global parameters -->
  <set_parameter name="use_sim_time" value="false" />

  <set_parameters_from_file filename="$(find-pkg-share auv_bringup)/config/environment.yaml" />

  <!-- launch parameter server -->
  <include file="$(find-pkg-share auv_bringup)/launch/param_server.launch">
    <arg name="namespace" value="$(var namespace)" />
  </include>

  <!-- launch state publisher  -->
  <include file="$(find-pkg-share auv_bringup)/launch/inc/localization/start_state_publisher.launch.xml">
    <arg name="namespace" value="$(var namespace)" />
    <arg name="use_gui" value="$(var use_gui)" />
    <arg name="model" value="$(var model)" />
    <arg name="rviz_config" value="$(var rviz_config)" />
  </include>

  <!-- launch vehicle sensors -->
  <include file="$(find-pkg-share auv_bringup)/launch/inc/sensors/start_sensors_$(var namespace).launch">
    <arg name="namespace" value="$(var namespace)" />
    <arg name="control_rate" value="$(var control_rate)" />
    <arg name="dvl_virtual_port" value="$(var dvl_virtual_port)" />
  </include>

  <include file="$(find-pkg-share auv_bringup)/launch/start_navigation.launch">
    <arg name="namespace" value="$(var namespace)" />
    <arg name="control_rate" value="$(var control_rate)" />
    <arg name="localization_disabled_at_startup" value="$(var localization_disabled_at_startup)" />
    <arg name="plane_fitter_sync_queue_size" value="$(var plane_fitter_sync_queue_size)" />
    <arg name="use_gui" value="$(var use_gui)" />
    <arg name="start_state_publisher" value="false" />
    <arg name="config_file" value="$(find-pkg-share auv_control)/config/$(var namespace)/default.yaml" />
  </include>

  <!-- launch logging -->
    <group if="$(var enable_logging)">
      <include file="$(find-pkg-share auv_bringup)/launch/logging.launch">
        <arg name="namespace" value="$(var namespace)" />
        <arg name="logging_directory" value="$(var logging_directory)" />
        <arg name="log_filename" value="$(var log_filename)" />
      </include>
    </group>

  <!-- Smach Monitor Node -->
  <node name="smach_monitor_node" pkg="auv_smach" exec="smach_monitor_node.py" output="screen" namespace="$(var namespace)">
      <remap from="vision/set_front_camera_focus" to="vision/set_front_camera_focus"/>
      <remap from="control/align_frame/cancel" to="control/align_frame/cancel"/>
      <remap from="set_heading_control" to="set_heading_control"/>
  </node>
</launch>
