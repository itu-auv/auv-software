<?xml version="1.0"?>
<launch>
  <arg name="namespace" default="taluy" />
  <arg name="control_rate" default="20.0" />
  <arg name="localization_disabled_at_startup" default="true" />
  <arg name="plane_fitter_sync_queue_size" default="30" />
  <arg name="model" default="$(eval find(arg('namespace') + '_description') + '/urdf/auv.urdf.xacro')" />
  <arg name="rviz_config" default="$(eval find(arg('namespace') + '_description') + '/rviz/araba.rviz')" />
  <arg name="dvl_virtual_port" default="/dev/auv_wayfinder_dvl" />
  <arg name="use_gui" default="false" />
  <arg name="enable_logging" default="false" />
  <arg name="logging_directory" default="$(optenv HOME)/bags" />
  <arg name="log_filename" default="" />

  <param name="/use_sim_time" value="false" type="bool" />

  <rosparam file="$(find auv_bringup)/config/environment.yaml" command="load" ns="" />

  <!-- launch parameter server -->
  <include file="$(find auv_bringup)/launch/param_server.launch">
    <arg name="namespace" value="$(arg namespace)" />
  </include>

  <!-- launch state publisher  -->
  <include file="$(find auv_bringup)/launch/inc/localization/start_state_publisher.launch.xml">
    <arg name="namespace" value="$(arg namespace)" />
    <arg name="use_gui" value="$(arg use_gui)" />
    <arg name="model" value="$(arg model)" />
    <arg name="rviz_config" value="$(arg rviz_config)" />
  </include>

  <!-- launch vehicle sensors -->
  <include file="$(find auv_bringup)/launch/inc/sensors/start_sensors_$(arg namespace).launch">
    <arg name="namespace" value="$(arg namespace)" />
    <arg name="control_rate" value="$(arg control_rate)" />
    <arg name="dvl_virtual_port" value="$(arg dvl_virtual_port)" />
  </include>

  <include file="$(find auv_bringup)/launch/start_navigation.launch">
    <arg name="namespace" value="$(arg namespace)" />
    <arg name="control_rate" value="$(arg control_rate)" />
    <arg name="localization_disabled_at_startup" value="$(arg localization_disabled_at_startup)" />
    <arg name="plane_fitter_sync_queue_size" value="$(arg plane_fitter_sync_queue_size)" />
    <arg name="use_gui" value="$(arg use_gui)" />
    <arg name="start_state_publisher" value="false" />
    <arg name="config_file" value="$(find auv_control)/config/$(arg namespace)/default.yaml" />
  </include>

  <!-- launch logging -->
    <group if="$(arg enable_logging)">
      <include file="$(find auv_bringup)/launch/logging.launch">
        <arg name="namespace" value="$(arg namespace)" />
        <arg name="logging_directory" value="$(arg logging_directory)" />
        <arg name="log_filename" value="$(arg log_filename)" />
      </include>
    </group>

  <!-- Smach Monitor Node -->
  <node name="smach_monitor_node" pkg="auv_smach" type="smach_monitor_node.py" output="screen" ns="$(arg namespace)">
      <remap from="vision/set_front_camera_focus" to="vision/set_front_camera_focus"/>
      <remap from="control/align_frame/cancel" to="control/align_frame/cancel"/>
      <remap from="set_heading_control" to="set_heading_control"/>
  </node>
</launch>
